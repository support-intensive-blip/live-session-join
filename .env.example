# --- Server ---
PORT=3000
NODE_ENV=development

# --- Google Form (served via GET /api/courses/:id, not submitted by this
# service — the authenticated CCBP page submits it directly. See
# ccbp-integration/INTEGRATION.md) ---
GOOGLE_FORM_ACTION_URL=https://docs.google.com/forms/d/e/1FAIpQLScv_SLntBNHY4Rc61ukmh2wX8-5Hh5KFG9rBO-AxryY-4yEgw/formResponse
GOOGLE_FORM_ENTRY_UID=entry.1412875435
GOOGLE_FORM_ENTRY_NAME=entry.1981656091
GOOGLE_FORM_ENTRY_COURSE=entry.2071464654

# --- Course-mapping override store (backs the admin dashboard) ---
# If unset, an in-process in-memory store is used (fine for local dev /
# a single instance only — overrides are lost on restart and don't
# coordinate across instances). Set for any multi-instance deployment or
# to persist overrides across restarts.
REDIS_URL=

# --- Admin dashboard (course -> webinar URL overrides) ---
# Protects /admin via HTTP Basic Auth. Treat ADMIN_PASSWORD like any other
# production credential (long, random, stored in a secrets manager).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
